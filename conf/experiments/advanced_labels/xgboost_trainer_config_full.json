{
  "loader_config_path": "${PROJECT_ROOT}/conf/experiments/advanced_labels/parquet_loader_config_full.json",
  "instruments": "all",
  "start_time": "2018-01-01",
  "end_time": "2025-12-31",
  "output_dir": "${PROJECT_ROOT}/outputs/xgb_cross_sectional_dataset",
  "model_dir": "${PROJECT_ROOT}/models",
  "model_filename": "xgboost_label_5d.json",
  "label_name": "label_20d",
  "prefer_gpu": false,
  "segments": {
    "train": [
      "2018-01-01",
      "2020-12-31"
    ],
    "valid": [
      "2021-01-01",
      "2022-12-31"
    ],
    "test": [
      "2023-01-01",
      "2025-12-31"
    ]
  },
  "model_params": {
    "n_estimators": 200,
    "max_depth": 8,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "objective": "reg:squarederror",
    "tree_method": "hist",
    "random_state": 42,
    "n_jobs": 8
  },
  "evaluation": {
    "enabled": false,
    "score_col": "pred",
    "return_horizons": [
      5,
      10,
      20
    ],
    "n_groups": 10,
    "top_ks": [
      50,
      100,
      200
    ],
    "upside_realized_frac": 0.1,
    "upside_predicted_fracs": [
      0.1,
      0.2
    ],
    "downside_bottom_frac": 0.1,
    "downside_crash_threshold": -0.095,
    "return_decile_n_groups": 10,
    "run_backtest": true,
    "backtest_config_path": "${PROJECT_ROOT}/conf/simple_backtester_config.json",
    "backtest_overrides": {}
  }
}