{
  "loader_config_path": "${PROJECT_ROOT}/conf/parquet_loader_config.json",
  "instruments": "all",
  "prefer_gpu": false,
  "label_name": "label_rank_20d",

  "walk_forward": {
    "train_start": "2000-01-01",
    "train_end": "2022-12-31",
    "test_start": "2005-01-01",
    "test_end": "2025-12-31",

    "backtest_start": "2023-01-01",
    "backtest_end": "2025-12-31",
    "oos_start": "2026-01-01",
    "oos_end": "2025-12-31",

    "mode": "rolling",
    "train_window_years": 5,
    "step_years": 1,
    "valid_ratio": 0.15,

    "model_params": {
      "n_estimators": 100,
      "max_depth": 8,
      "learning_rate": 0.003,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 50,
      "gamma": 0.1,
      "objective": "reg:squarederror",
      "tree_method": "hist",
      "random_state": 42,
      "n_jobs": 8
    }
  },

  "backtest": {
    "topk": 50,
    "n_drop": 5,
    "signal_delay": 1,
    "open_cost": 0.0005,
    "close_cost": 0.0015,
    "slippage": 0.001,
    "min_cost": 5.0,
    "account": 1000000
  },

  "output": {
    "model_dir": "${PROJECT_ROOT}/output/walk_forward_enhanced_alpha/models",
    "prediction_dir": "${PROJECT_ROOT}/output/walk_forward_enhanced_alpha/predictions",
    "backtest_dir": "${PROJECT_ROOT}/output/walk_forward_enhanced_alpha/backtest"
  }
}
