{
  "version": "optimizer_v1_full",
  "description": "Portfolio Optimizer V1 Full (Phases 1-5): Alpha + Risk + Industry + Style + Turnover + Attribution",

  "alpha": {
    "method": "zscore",
    "winsorize": true,
    "winsorize_quantile": 0.01
  },

  "candidate_pool": {
    "pool_size": 100,
    "min_avg_amount_20d": 50000,
    "filter_st": true,
    "filter_suspend": true,
    "filter_new_stock_days": 60
  },

  "objective": {
    "risk_aversion": 0.1,
    "turnover_penalty": 0.01
  },

  "constraints": {
    "long_only": true,
    "fully_invested": true,
    "max_weight": 0.03,

    "industry": {
      "max_weight": 0.20
    },

    "style": {
      "SIZE": [-0.5, 0.5],
      "BETA": [0.7, 1.2],
      "MOMENTUM": [-0.5, 0.8],
      "VALUE": [-0.5, 0.5],
      "GROWTH": [-0.5, 0.8],
      "VOLATILITY": [-0.5, 0.5],
      "LIQUIDITY": [-0.5, 0.5],
      "LEVERAGE": [-0.5, 0.5]
    }
  },

  "solver": {
    "solver": "OSQP",
    "verbose": false,
    "max_iter": 10000,
    "eps_abs": 1e-5,
    "eps_rel": 1e-5,
    "warm_start": true
  },

  "risk_model": {
    "output_dir": "${PROJECT_ROOT}/outputs/risk_model/v1"
  },

  "backtest": {
    "rebalance_freq": 5,
    "start_date": null,
    "end_date": null
  },

  "output": {
    "base_dir": "${PROJECT_ROOT}/output/optimizer_backtest"
  }
}
